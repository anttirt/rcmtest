.memory-profiler-left-pane__toolbar
{
    flex-shrink: 0;
    flex-direction: row;
    padding: 3px;
    align-items: center;
}

.memory-profiler-left-pane__options
{
    width: 16px;
    height: 16px;
    padding: 0px;
    border-width: 0px;
    border-radius: 0px;
    margin: 0px;
    background-color: transparent;
}

.memory-profiler-left-pane__message
{
    flex-grow: 1;
    margin: 2px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.memory-profiler-left-pane__content
{
    flex-grow: 1;
}

.memory-profiler-left-pane__header
{
    flex-direction: row;
    height: 24px;
}

.memory-profiler-left-pane__column-header
{
    flex-grow: 1;
    padding-left: 4px;
    border-left-width: 1px;
    -unity-text-align: middle-left;
}

#tree-view-container
{
    flex-grow: 1;
}
.memory-profiler-left-pane__tree-view
{
    flex-grow: 1;
}
