.query-with-entities__open-query-window-button {
    background-color: transparent;
    border-color: transparent;
    background-image: var(--open-in-window-icon);
    width:16px;
    height:16px;
    flex-shrink: 0;
    flex-grow: 0;
}

.query-with-entities__see-all {
    align-self: flex-start;
    font-size: 12px;
    padding-top: 1px;
    padding-bottom: 1px;
    padding-left: 6px;
    padding-right: 6px;
    margin-top: 2px;
}

.query-with-entities__toggle-content {
    padding-left: 18px;
}

.query-with-entities__entity-icon {
    width: 16px;
    height: 16px;
    margin-right: 3px;
    flex-shrink: 0;
    flex-grow: 0;
    background-image: var(--entity-icon);
}

.query-with-entities__entity-row--nested {
    padding-left: 16px;
}
